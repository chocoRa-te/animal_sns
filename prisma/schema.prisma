generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  showLikeCount         Boolean   @default(false) // いいね数の表示
  notificationsOn       Boolean   @default(true) // 通知のオン・オフ
  isPrivate             Boolean   @default(false) // プライバシー設定
  bio                   String? // 自己紹介
  showActivity          Boolean   @default(true) // アクティビティステータス
  commentsEnabled       Boolean   @default(true) // コメントのオン・オフ
  showReadReceipt       Boolean   @default(true) // 既読表示のオン・オフ
  allowDMRequests       Boolean   @default(true) // メッセージリクエストのオン・オフ
  requireFollowApproval Boolean   @default(false) // フォロー承認制

  accounts          Account[]
  sessions          Session[]
  pins              Pin[]
  boards            Board[]
  comments          Comment[]
  likes             Like[]
  following         Follow[]         @relation("following")
  followers         Follow[]         @relation("followers")
  chatRooms         ChatRoomMember[]
  messages          Message[]
  notifications     Notification[]   @relation("notifications")
  sentNotifications Notification[]   @relation("sentNotifications")
  blocking          Block[]          @relation("blocking")
  blockedBy         Block[]          @relation("blockedBy")
  albums            Album[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Album {
  id        String     @id @default(cuid())
  title     String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pins      AlbumPin[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model AlbumPin {
  id        String   @id @default(cuid())
  albumId   String
  pinId     String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([albumId, pinId])
}

model Pin {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?  @default("その他")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videoUrl    String? // 動画URL
  type        String   @default("image") // "image" | "video"

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId String?
  board   Board?  @relation(fields: [boardId], references: [id])

  comments      Comment[]
  likes         Like[]
  notifications Notification[]
  albums        AlbumPin[]
}

model Board {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pins   Pin[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinId  String
  pin    Pin    @relation(fields: [pinId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinId  String
  pin    Pin    @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@unique([userId, pinId])
}

model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  status    String   @default("accepted") // "pending" | "accepted"

  followerId  String
  follower    User   @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

//チャットルーム（１対１）またはグループ
model ChatRoom {
  id        String   @id @default(cuid())
  name      String? //グループ名(１対１の場合はnull)
  isGroup   Boolean  @default(false)
  isRequest Boolean  @default(false)
  createdAt DateTime @default(now())

  members  ChatRoomMember[]
  messages Message[]
}

// チャットルームのメンバー
model ChatRoomMember {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  muteNotifications Boolean  @default(false) // このチャットの通知をオフ

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

//message
model Message {
  id        String   @id @default(cuid())
  content   String
  read      Boolean  @default(false) // ← 追加
  createdAt DateTime @default(now())

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

// 通知
model Notification {
  id        String   @id @default(cuid())
  type      String // "like" | "comment" | "follow"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // 通知を受け取るユーザー
  userId String
  user   User   @relation("notifications", fields: [userId], references: [id], onDelete: Cascade)

  // 通知を送ったユーザー
  senderId String
  sender   User   @relation("sentNotifications", fields: [senderId], references: [id], onDelete: Cascade)

  // 関連するピン（いいね・コメントの場合）
  pinId String?
  pin   Pin?    @relation(fields: [pinId], references: [id], onDelete: Cascade)
}

// ブロック
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("blockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}
